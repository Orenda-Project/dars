{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "npm run start",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 5
  },
  "envs": {
    "NEXT_PUBLIC_API_URL": {
      "description": "API endpoint URL",
      "default": "http://localhost:8000"
    }
  }
}
