# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright e2e
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# next.js
/.next/
/out/

# generated showcase LPs (regenerated by useful-scripts/generate_showcase_lps.py)
# Default: gitignored. Specific committed tags are un-ignored below so they ship to staging.
/public/showcase/*
!/public/showcase/lp-showcase/
!/public/showcase/_assets/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.superpowers/
