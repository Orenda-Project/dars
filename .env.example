# Copy this file to .env and fill in your values
# Never commit .env to git

# Supabase project ref (used by Makefile — run `make db-link` once to link the CLI)
SUPABASE_PROJECT_REF=your-project-ref


# Supabase Auth — get from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Database — get the "Transaction" connection string from Supabase dashboard > Settings > Database
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# LP Assistant microservice
# Production URL — no local equivalent
LP_ASSISTANT_URL=https://lp-assistant.taleemabad.com
LP_ASSISTANT_API_KEY=<your-lp-assistant-api-key>

# App settings
DEBUG=false
ADMIN_SECRET=change-me-to-a-random-string

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# taleemabad-core DB — used by scripts/import_ncp_slos.py (read-only access needed)
# Get these from the core deployment / staging DB credentials
CORE_DB_HOST=localhost
CORE_DB_PORT=5432
CORE_DB_NAME=taleemabad
CORE_DB_USER=postgres
CORE_DB_PASSWORD=
