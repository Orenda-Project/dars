# Chapter Planning Engine (CPE) — example environment
# Copy to .env and adjust as needed.

# stage | prod
ENVIRONMENT=stage

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# NOTE: The Phase 2 LLM planner uses claude-agent-sdk, which authenticates via your
