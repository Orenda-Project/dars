{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dars API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "dars.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "jinja": true,
      "cwd": "${workspaceFolder}/server",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/server/src"
      },
      "envFile": "${workspaceFolder}/server/.env"
    }
  ]
}
